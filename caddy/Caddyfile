{
	# Geen HTTP→HTTPS-redirect op poort 80: die poort is vaak al bezet (bijv. OMV)
	auto_https disable_redirects
	http_port {$CADDY_HTTP_PORT:8880}
}

{$DUCKDNS_DOMAIN}.duckdns.org:{$HTTPS_PORT:443} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Dashboard draait op de host (network_mode: host); websockets (SignalR) gaan vanzelf mee
	reverse_proxy localhost:5000
}
