<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Small Windows agent that exposes this PC to the dashboard server. One exe, two modes:
      (default)  stats + power actions — runs as SYSTEM at boot (port 5055)
      - -media   now-playing media + controls + sound output — runs in the user's session at logon (port 5056),
                 because Windows only shows media sessions to the logged-in user
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <AssemblyName>HomeDashboardAgent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Reuse the dashboard's Windows code so the agent reports exactly what the dashboard would. -->
  <ItemGroup>
    <Compile Include="..\HomeDashboard.Api\Models\SystemStats.cs" Link="Shared\SystemStats.cs" />
    <Compile Include="..\HomeDashboard.Api\Services\SystemMonitorService.cs" Link="Shared\SystemMonitorService.cs" />
    <Compile Include="..\HomeDashboard.Api\Models\MediaInfo.cs" Link="Shared\MediaInfo.cs" />
    <Compile Include="..\HomeDashboard.Api\Services\MusicService.cs" Link="Shared\MusicService.cs" />
    <Compile Include="..\HomeDashboard.Api\Models\AudioOutputDevice.cs" Link="Shared\AudioOutputDevice.cs" />
    <Compile Include="..\HomeDashboard.Api\Services\AudioService.cs" Link="Shared\AudioService.cs" />
  </ItemGroup>

</Project>
