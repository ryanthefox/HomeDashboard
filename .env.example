# Kopieer dit bestand naar .env en vul je eigen waarden in
# Het .env bestand wordt NOOIT naar Git gepusht

# Inloggen — wachtwoord voor het dashboard. Leeg laten = iedereen op je netwerk kan erbij.
DASHBOARD_PASSWORD=kies-een-sterk-wachtwoord

# HTTPS via DuckDNS (optioneel) — maak een subdomein aan op https://www.duckdns.org
# COMPOSE_PROFILES=https
# DUCKDNS_DOMAIN=mijnhuis          (zonder .duckdns.org)
# DUCKDNS_TOKEN=...
# HTTPS_PORT=443                   (poort op de server; zet je router extern 443 hierheen)

# Philips Hue
HUE_BRIDGE_IP=192.168.1.x
HUE_API_KEY=jouw-hue-api-sleutel

# LG ThinQ
LGTHINQ_PAT=jouw-personal-access-token
LGTHINQ_CLIENT_ID=jouw-client-uuid

# Plex — token: zie https://support.plex.tv/articles/204059436
PLEX_TOKEN=jouw-plex-token
# Optioneel — standaard Plex op dezelfde machine als het dashboard
# PLEX_SERVER_URL=http://192.168.1.x:32400

# Afvalkalender — standaard HomeDashboard.Api/data/afval.ics (zit in de repo),
# of vul hier een iCal-link van je gemeente / afvalinzamelaar in
# AFVAL_ICAL_URL=https://...

# Frank Energie (optioneel) — de stroom- en gasprijzen werken altijd; met je
# Frank-login (dezelfde als in de app) toont het dashboard ook je eigen verbruik en kosten.
# Zet het wachtwoord tussen enkele aanhalingstekens als het $ of # bevat.
# FRANK_EMAIL=jij@voorbeeld.nl
# FRANK_PASSWORD='...'

# Ring-deurbel — niets nodig hier: log in via de Ring-tegel in het dashboard.
# Optioneel een andere poort voor de interne ring-bridge:
# RING_PORT=5057

# Optioneel — standaard Veenendaal
# WEATHER_LAT=52.0259
# WEATHER_LON=5.5553
# WEATHER_TZ=Europe/Amsterdam

# Optioneel — standaard NL / EIC endpoint
# LGTHINQ_COUNTRY=NL
# LGTHINQ_BASE_URL=https://api-eic.lgthinq.com

# PC — stats en aan/uit. Draai HomeDashboard.Agent/install-agent.ps1 op je PC,
# dat script geeft deze drie waarden.
# PC_AGENT_URL=http://192.168.178.x:5055
# PC_AGENT_KEY=...
# PC_MAC=AA:BB:CC:DD:EE:FF
# Optioneel
# PC_NAME=PC
# PC_BROADCAST=192.168.178.255
# PC_MEDIA_URL=http://192.168.178.x:5056   (standaard: agent-URL met poort +1)

# Google Home (optioneel) — "Hey Google, zet de computer aan". Vereist HTTPS (DuckDNS)
# en DASHBOARD_PASSWORD. Verzin zelf een client-id en een lang geheim; vul dezelfde
# waarden in bij "Account linking" in de Google Home Developer Console.
# GOOGLE_CLIENT_ID=homedashboard
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_DEVICE_NAME=Computer      (naam in Google Home; standaard PC_NAME)

# Agenda (optioneel) — Google Agenda > Instellingen > (je agenda) > "Geheim adres in iCal-indeling".
# Meerdere agenda's: komma-gescheiden. Dit adres geeft leestoegang, deel het met niemand.
# CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/.../basic.ics,https://...

# Reistijd naar werk (optioneel)
# Auto (met files): gratis TomTom-sleutel van developer.tomtom.com (geen creditcard nodig),
# óf een Google Maps "Routes API"-sleutel (vereist factuuraccount). Google gaat voor als beide er staan.
# TRAVEL_HOME_ADDRESS=Straat 1, 3901 AB Veenendaal
# TRAVEL_WORK_ADDRESS=Straat 2, 3511 AB Utrecht
# TOMTOM_KEY=...
# GOOGLE_MAPS_KEY=...
# Trein: NS-sleutel (apiportal.ns.nl, product "Ns-App") + stationscodes (bijv. VNDC, UT)
# TRAVEL_HOME_STATION=VNDC
# TRAVEL_WORK_STATION=UT
# NS_API_KEY=...
