# Kopieer dit bestand naar .env en vul je eigen waarden in
# Het .env bestand wordt NOOIT naar Git gepusht

# Inloggen — wachtwoord voor het dashboard. Leeg laten = iedereen op je netwerk kan erbij.
DASHBOARD_PASSWORD=kies-een-sterk-wachtwoord

# Philips Hue
HUE_BRIDGE_IP=192.168.1.x
HUE_API_KEY=jouw-hue-api-sleutel

# LG ThinQ
LGTHINQ_PAT=jouw-personal-access-token
LGTHINQ_CLIENT_ID=jouw-client-uuid

# Plex — token: zie https://support.plex.tv/articles/204059436
PLEX_TOKEN=jouw-plex-token
# Optioneel — standaard Plex op dezelfde machine als het dashboard
# PLEX_SERVER_URL=http://192.168.1.x:32400

# Afvalkalender — standaard HomeDashboard.Api/data/afval.ics (zit in de repo),
# of vul hier een iCal-link van je gemeente / afvalinzamelaar in
# AFVAL_ICAL_URL=https://...

# Optioneel — standaard Veenendaal
# WEATHER_LAT=52.0259
# WEATHER_LON=5.5553
# WEATHER_TZ=Europe/Amsterdam

# Optioneel — standaard NL / EIC endpoint
# LGTHINQ_COUNTRY=NL
# LGTHINQ_BASE_URL=https://api-eic.lgthinq.com

# PC — stats en aan/uit. Draai HomeDashboard.Agent/install-agent.ps1 op je PC,
# dat script geeft deze drie waarden.
# PC_AGENT_URL=http://192.168.178.x:5055
# PC_AGENT_KEY=...
# PC_MAC=AA:BB:CC:DD:EE:FF
# Optioneel
# PC_NAME=PC
# PC_BROADCAST=192.168.178.255
# PC_MEDIA_URL=http://192.168.178.x:5056   (standaard: agent-URL met poort +1)
